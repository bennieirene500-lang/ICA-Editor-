# Local development. Never commit a real .env file.
NODE_ENV=development
PORT=3000
ICA_AUTH_MODE=optional

# Required for production rendering.
OPENAI_API_KEY=
PEXELS_API_KEY=

# Required when ICA_AUTH_MODE=required.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Production guardrails.
FFMPEG_PATH=ffmpeg
MAX_UPLOAD_MB=500
OUTPUT_TTL_MINUTES=45
MAX_CONCURRENT_JOBS=1
MAX_PENDING_JOBS=5
DEFAULT_BETA_VIDEO_ALLOWANCE=5
